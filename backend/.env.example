# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/oceanshield?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Image storage (Cloudinary). If unset, uploads fall back to local disk in /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI service (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Satellite (NASA Worldview / GIBS). GIBS needs no authentication.
# These optional overrides are rarely changed.
GIBS_BASE_URL=https://gibs.earthdata.nasa.gov
WORLVIEW_SNAPSHOTS_URL=https://wvs.earthdata.nasa.gov/api/v1/snapshot

# Upload limits
MAX_IMAGE_UPLOAD_MB=10
